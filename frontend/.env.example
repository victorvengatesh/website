# FastAPI backend. Leave blank to use the built-in mock catalog and checkout demo.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Checkout is UI-only until a payment provider is connected.
NEXT_PUBLIC_DEMO_CHECKOUT=true

# Add Stripe's public key when the payment integration is enabled.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
